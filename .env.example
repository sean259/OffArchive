# Copy this file to `.env` and fill in the values from Supabase → Project Settings → API.
# Both values are safe to expose in the browser: row-level security (supabase/migrations)
# decides what each visitor can read or change. Never put the service_role key here.
#
# Leave them empty to run the site read-only from the Markdown files in src/content/items.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
