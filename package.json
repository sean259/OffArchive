{
  "name": "offarchive",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "description": "OFFARCHIVE. — Curated. Collected. Released. A personal resale archive based in Cebu, Philippines.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:db": "node supabase/tests/rls.test.mjs",
    "photos": "node tools/photos.mjs",
    "seed:export": "node tools/export-seed.mjs",
    "astro": "astro",
    "sample-photos": "node tools/sample-photos.mjs",
    "db:check": "node --env-file-if-exists=.env tools/check-supabase.mjs",
    "db:login": "npx -y supabase@2 login",
    "db:link": "npx -y supabase@2 link",
    "db:push": "npx -y supabase@2 db push",
    "brand": "node tools/brand.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.11",
    "lenis": "^1.3.27",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.19.2",
    "js-yaml": "^4.3.2",
    "opentype.js": "^1.3.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.161.0"
  }
}
