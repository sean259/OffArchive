---
/**
 * Quick view: a preview of a piece (photos, price, size, condition, seller) without leaving
 * the grid. Opened by any [data-quick="<item id>"] button; filled from the embedded catalog
 * by scripts/quick.ts. Desktop: centred two-column panel. Phones: a bottom sheet.
 */
---

<dialog class="qv" id="quick" aria-labelledby="qv-title">
  <div class="qv-inner" data-qv-body tabindex="-1"></div>
  <button class="qv-x round" type="button" data-qv-close aria-label="Close quick view">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</dialog>

<script>
  import '../scripts/quick';
</script>

<style>
  .qv {
    width: min(1040px, calc(100vw - 48px));
    max-height: min(720px, calc(100dvh - 48px));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.55);
  }
  .qv::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(6px);
  }
  .qv[open] {
    animation: qv-in 0.55s var(--ease);
  }
  .qv[open]::backdrop {
    animation: qv-fade 0.4s ease;
  }
  @keyframes qv-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }
  @keyframes qv-fade {
    from {
      opacity: 0;
    }
  }
  .qv-x {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
  }
  .qv-inner {
    outline: none;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    max-height: inherit;
  }

  /* Gallery */
  .qv :global(.qv-gallery) {
    position: relative;
    background: var(--paper-2);
    min-height: 0;
  }
  .qv :global(.qv-track) {
    display: flex;
    height: 100%;
    max-height: min(720px, calc(100dvh - 48px));
    aspect-ratio: 4 / 5;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .qv :global(.qv-track::-webkit-scrollbar) {
    display: none;
  }
  .qv :global(.qv-slide) {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: grid;
    place-items: center;
  }
  .qv :global(.qv-slide img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: var(--photo-blend);
    filter: var(--photo-filter);
  }
  .qv :global(.qv-slide svg) {
    width: 46%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0.8;
  }
  .qv :global(.qv-dots) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .qv :global(.qv-dots button) {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 30%, transparent);
    transition:
      width 0.4s var(--ease),
      background 0.3s;
  }
  .qv :global(.qv-dots button[aria-current='true']) {
    width: 20px;
    background: var(--ink);
  }

  /* Details */
  .qv :global(.qv-info) {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(28px, 4vw, 48px);
    overflow-y: auto;
  }
  .qv :global(.qv-title) {
    font: 400 clamp(34px, 3.4vw, 48px) / 0.98 var(--display);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .qv :global(.qv-price) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .qv :global(.qv-price strong) {
    font: 400 30px/1 var(--display);
  }
  .qv :global(.qv-specs) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 14px;
    margin: 0;
  }
  .qv :global(.qv-specs dd) {
    margin: 6px 0 0;
    font-size: 15px;
  }
  .qv :global(.qv-blurb) {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .qv :global(.qv-actions) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    margin-top: auto;
  }
  .qv :global(.qv-actions .btn--block) {
    grid-column: 1 / -1;
  }
  .qv :global(.save svg) {
    fill: transparent;
    transition: fill 0.3s;
  }
  .qv :global(.save[aria-pressed='true'] svg) {
    fill: currentColor;
  }
  .qv :global(.qv-seller) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  @media (max-width: 760px) {
    .qv {
      width: 100vw;
      max-width: 100vw;
      max-height: 92dvh;
      margin: auto 0 0;
      border-radius: 20px 20px 0 0;
      border-bottom: 0;
    }
    .qv[open] {
      animation: qv-up 0.5s var(--ease);
    }
    @keyframes qv-up {
      from {
        transform: translateY(100%);
      }
    }
    .qv-inner {
      grid-template-columns: 1fr;
      overflow-y: auto;
      max-height: 92dvh;
    }
    .qv :global(.qv-track) {
      width: 100%;
      height: min(52dvh, 120vw);
      max-height: none;
      aspect-ratio: auto;
    }
    .qv :global(.qv-info) {
      overflow: visible;
      padding: 24px 20px calc(24px + env(safe-area-inset-bottom));
    }
  }
</style>
