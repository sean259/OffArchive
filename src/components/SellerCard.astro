---
/** "Sold by" block on item pages: who the seller is and how to reach them. */
import { sellerPath, type Seller } from '../lib/items';

interface Props {
  seller: Seller;
}
const { seller } = Astro.props;
const initial = seller.name.trim().charAt(0).toUpperCase() || '·';
---

<div class:list={['seller', { official: seller.official }]}>
  <a class="who" href={sellerPath(seller)}>
    <span class="avatar" aria-hidden="true">{seller.official ? 'O.' : initial}</span>
    <span class="txt">
      <span class="label muted">{seller.official ? 'Sold by the archive' : 'Sold by'}</span>
      <span class="name">
        {seller.name}
        {seller.verified && !seller.official && <span class="tick" title="Verified seller">✓</span>}
      </span>
      <span class="label muted">@{seller.username} · {seller.location}</span>
    </span>
  </a>
  <div class="links label">
    {seller.phone && <a href={`tel:${seller.phone.replace(/\s/g, '')}`}>Call</a>}
    {seller.instagram && <a href={`https://instagram.com/${seller.instagram}`} target="_blank" rel="noopener">Instagram ↗</a>}
    <a href={sellerPath(seller)}>All pieces →</a>
  </div>
</div>

<style>
  .seller {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .official {
    background: var(--paper-2);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--on-ink);
    font: 400 24px var(--display);
    flex: none;
  }
  .official .avatar {
    background: var(--accent);
    color: var(--on-accent);
    font: 700 16px var(--sans);
    letter-spacing: -0.04em;
  }
  .txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .name {
    font: 400 24px/1.1 var(--display);
  }
  .who:hover .name {
    color: var(--accent);
  }
  .tick {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-left: 6px;
    border-radius: 50%;
    background: var(--ok);
    color: var(--on-accent);
    font: 500 9px var(--sans);
    vertical-align: 3px;
  }
  .links {
    display: flex;
    gap: 16px;
  }
  .links a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
