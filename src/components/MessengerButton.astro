---
/**
 * Opens a Messenger chat with the page. If `message` is set, the chat opens with it already typed
 * (m.me `?text=` / sms `?body=`), and it is also copied on click (scripts/ui.ts) as a fallback.
 */
import { messengerUrl } from '../config/site';
import { withMessage } from '../lib/contact';

interface Props {
  message?: string;
  label?: string;
  variant?: 'dark' | 'light';
  block?: boolean;
  disabled?: boolean;
  disabledLabel?: string;
  magnetic?: boolean;
  /** Full Messenger URL for a specific seller (defaults to the shop's page). */
  href?: string;
}

const {
  message,
  label = 'Message on Messenger',
  variant = 'dark',
  block = false,
  disabled = false,
  disabledLabel = 'Released — sold',
  magnetic = false,
  href = messengerUrl,
} = Astro.props;
---

{
  disabled ? (
    <span class:list={['btn', { 'btn--block': block }]} aria-disabled="true">
      {disabledLabel}
    </span>
  ) : (
    <a
      class:list={['btn', { 'btn--light': variant === 'light', 'btn--block': block }]}
      href={withMessage(href, message)}
      target="_blank"
      rel="noopener"
      data-copy={message}
      data-magnetic={magnetic ? '' : undefined}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3C6.9 3 3 6.7 3 11.4c0 2.6 1.2 4.9 3.2 6.4V21l3-1.7c.9.2 1.8.4 2.8.4 5.1 0 9-3.7 9-8.4S17.1 3 12 3z" />
        <path d="M7 14l3.5-3.7 2.5 2.4L17 9.5" />
      </svg>
      {label}
      <span class="arrow" aria-hidden="true">
        →
      </span>
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  )
}
