---
/**
 * Embeds a compact JSON index of every public item, read by the Saved drawer and Search
 * (src/lib/catalog.ts). Rendered once per page by BaseLayout.
 */
import { getImage } from 'astro:assets';
import { getItems, catalogNo, itemPath, isRemote, messengerFor } from '../lib/items';
import { peso } from '../lib/format';
import { ART } from '../lib/art';
import { sizeSpec } from '../config/site';

const items = await getItems();
const entries = await Promise.all(
  items.map(async (item, order) => {
    const cover = item.data.images[0];
    const thumb = !cover ? undefined : isRemote(cover) ? cover.src : (await getImage({ src: cover, width: 160, format: 'webp' })).src;
    const s = item.data.seller;
    // Up to 4 medium photos for Quick view (uploaded photos are already web-sized).
    const photos = await Promise.all(
      item.data.images.slice(0, 4).map(async (p) => (isRemote(p) ? p.src : (await getImage({ src: p, width: 800, format: 'webp' })).src)),
    );
    const d = item.data;
    return [
      item.id,
      {
        id: item.id,
        order,
        no: catalogNo(item),
        title: item.data.title,
        brand: item.data.brand ?? '',
        category: item.data.category,
        condition: item.data.condition,
        price: item.data.price,
        priceLabel: peso(item.data.price),
        size: item.data.size,
        status: item.data.status,
        url: itemPath(item),
        thumb,
        photos,
        sizeLabel: sizeSpec(d.category)?.label ?? 'Size',
        fit: d.fit ?? null,
        flaws: d.flaws,
        blurb: item.body.length > 180 ? item.body.slice(0, 177).trimEnd() + '…' : item.body,
        listed: d.listed.getTime(),
        art: ART[item.data.art],
        seller: { username: s.username, name: s.name, official: s.official, messenger: s.messenger ? messengerFor(s) : null, phone: s.phone },
      },
    ] as const;
  }),
);
const json = JSON.stringify(Object.fromEntries(entries)).replace(/</g, '\\u003c');
---

<script type="application/json" id="catalog" set:html={json} />
