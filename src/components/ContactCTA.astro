---
import MessengerButton from './MessengerButton.astro';
import { SITE } from '../config/site';
---

<section class="contact" id="contact">
  <div class="wrap">
    <span class="label tag">(05) Contact</span>
    <h2 class="big rise">
      <span class="ln" style="--i:0"><span>Found</span></span>
      <span class="ln" style="--i:1"><span><em>something?</em></span></span>
    </h2>
    <div class="row rv">
      <p>Questions about a piece, sizing, or a bundle deal? Let’s talk. <span class="dim">{SITE.replyTime}.</span></p>
      <MessengerButton variant="light" magnetic />
    </div>

    <div class="notify rv" id="notify">
      <div>
        <span class="label dim">Next drop</span>
        <p class="serif">Be first in line when <em>new pieces</em> land.</p>
      </div>
      <div class="actions">
        <MessengerButton
          variant="light"
          label="Notify me on Messenger"
          message="Hi! Please let me know when the next OFFARCHIVE. drop is up."
        />
        {
          SITE.newsletter && (
            <form
              class="email"
              action={`https://buttondown.com/api/emails/embed-subscribe/${SITE.newsletter}`}
              method="post"
              target="_blank"
            >
              <label class="sr-only" for="nl-email">
                Email address
              </label>
              <input id="nl-email" type="email" name="email" placeholder="Or your email" required autocomplete="email" />
              <button type="submit" class="label">
                Subscribe →
              </button>
            </form>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--ink);
    color: var(--on-ink);
    overflow: hidden;
  }
  .tag,
  .dim {
    opacity: 0.55;
  }
  .big {
    font-size: clamp(72px, 15vw, 260px);
    line-height: 0.85;
    margin: 32px 0 56px;
  }
  .big .ln:nth-child(2) {
    padding-left: 18%;
  }
  .big em {
    color: var(--accent);
  }
  .row,
  .notify {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    flex-wrap: wrap;
    padding-top: 28px;
    border-top: 1px solid color-mix(in srgb, var(--on-ink) 20%, transparent);
  }
  .notify {
    margin-top: 56px;
  }
  .notify .serif {
    font-size: clamp(26px, 2.4vw, 36px);
    line-height: 1.1;
    margin-top: 10px;
    max-width: 22ch;
  }
  .notify em {
    color: var(--accent);
  }
  .notify :global(.btn--light) {
    background: transparent;
    color: var(--on-ink);
    border-color: color-mix(in srgb, var(--on-ink) 40%, transparent);
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .email {
    display: flex;
    height: 52px;
    border: 1px solid color-mix(in srgb, var(--on-ink) 40%, transparent);
    border-radius: 999px;
    overflow: hidden;
  }
  .email input {
    width: 220px;
    border: 0;
    background: none;
    color: inherit;
    padding: 0 20px;
    font: inherit;
    outline: none;
  }
  .email input::placeholder {
    color: inherit;
    opacity: 0.5;
  }
  .email button {
    border: 0;
    background: var(--on-ink);
    color: var(--ink);
    padding: 0 20px;
  }
  p {
    font: 400 clamp(22px, 2vw, 28px) / 1.3 var(--display);
    max-width: 32ch;
  }
  /* Rise animation plays when the section scrolls in, not on page load. */
  :global(.js) .contact .rise .ln > span {
    animation-play-state: paused;
  }
  :global(.js) .contact.seen .rise .ln > span {
    animation-play-state: running;
  }
  @media (max-width: 760px) {
    .big .ln:nth-child(2) {
      padding-left: 0;
    }
    .actions,
    .actions > :global(*),
    .email {
      width: 100%;
    }
    .email input {
      flex: 1;
      width: auto;
    }
  }
</style>

<script>
  const el = document.querySelector('.contact');
  if (el && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          el.classList.add('seen');
          io.disconnect();
        }
      },
      { threshold: 0.25 },
    );
    io.observe(el);
  } else el?.classList.add('seen');
</script>
