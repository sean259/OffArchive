---
/**
 * Item gallery. Desktop: photos stacked vertically beside a sticky info panel.
 * Mobile: swipeable carousel with a counter. Falls back to the illustration.
 */
import type { Item } from '../lib/items';
import Photo from './Photo.astro';
import ProductMedia from './ProductMedia.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  item: Item;
}
const { item } = Astro.props;
const { images, title, status } = item.data;
const sizes = '(max-width: 860px) 100vw, 55vw';
---

<div class="gallery" data-gallery>
  {
    images.length > 0 ? (
      <>
        <div class="slides" data-slides>
          {images.map((src, i) => (
            <div class="frame slide pf" style={i === 0 ? `view-transition-name: item-${item.id}` : undefined}>
              {i === 0 && <StatusBadge status={status} />}
              <Photo
                photo={src}
                alt={`${title} — photo ${i + 1} of ${images.length}`}
                widths={[600, 1000, 1400, 2000]}
                sizes={sizes}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="photo"
                data-g-img
              />
              <button
                type="button"
                class="zoom-hit"
                data-zoom={i}
                data-cursor-label="Zoom"
                aria-label={`Enlarge photo ${i + 1} of ${images.length}`}
              />
            </div>
          ))}
        </div>
        {images.length > 1 && (
          <div class="counter label" aria-hidden="true">
            <span data-current>1</span> / {images.length}
          </div>
        )}

        <dialog class="lb" data-lb aria-label={`${title}: photos`}>
          <div class="lb-track" data-lb-track>
            {images.map((_, i) => (
              <div class="lb-slide">
                <img data-lb-img alt={`${title} — photo ${i + 1} of ${images.length}`} decoding="async" draggable="false" />
              </div>
            ))}
          </div>
          <p class="lb-bar label">
            <span>
              <span data-lb-current>1</span> / {images.length}
            </span>
            <span class="muted" data-lb-hint>
              Tap to zoom
            </span>
          </p>
          {images.length > 1 && (
            <>
              <button type="button" class="lb-nav lb-prev round" data-lb-step="-1" aria-label="Previous photo">
                <span aria-hidden="true">←</span>
              </button>
              <button type="button" class="lb-nav lb-next round" data-lb-step="1" aria-label="Next photo">
                <span aria-hidden="true">→</span>
              </button>
            </>
          )}
          <button type="button" class="lb-x round" data-lb-close aria-label="Close photos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </dialog>
      </>
    ) : (
      <ProductMedia item={item} sizes={sizes} eager caption="Illustration · photos coming soon" />
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const track = g.querySelector<HTMLElement>('[data-slides]');
    const current = g.querySelector<HTMLElement>('[data-current]');
    if (!track || !current) return;
    track.addEventListener(
      'scroll',
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        current.textContent = String(i + 1);
      },
      { passive: true },
    );
  });

  /* ── Full-screen photo viewer: swipe / arrows between photos, tap to zoom, pan while zoomed ── */
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const lb = g.querySelector<HTMLDialogElement>('[data-lb]');
    const track = g.querySelector<HTMLElement>('[data-lb-track]');
    if (!lb || !track) return;
    const sources = [...g.querySelectorAll<HTMLImageElement>('[data-g-img]')];
    const imgs = [...lb.querySelectorAll<HTMLImageElement>('[data-lb-img]')];
    const counter = lb.querySelector<HTMLElement>('[data-lb-current]')!;
    const hint = lb.querySelector<HTMLElement>('[data-lb-hint]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SCALE = 2.5;
    const clamp = (v: number) => Math.min(100, Math.max(0, v));
    let index = 0;

    // Copy the photo's sources across on first view; srcset with 100vw picks the largest size.
    const load = (i: number) => {
      const img = imgs[i];
      const src = sources[i];
      if (!img || !src || img.getAttribute('src')) return;
      if (src.srcset) {
        img.sizes = '100vw';
        img.srcset = src.srcset;
      }
      img.src = src.currentSrc || src.src;
    };

    // Zoom scales the image around a transform-origin that follows the mouse or is dragged by a finger.
    let zoomed: HTMLImageElement | null = null;
    let ox = 50;
    let oy = 50;
    const box = (img: HTMLImageElement) => {
      const r = img.parentElement!.getBoundingClientRect(); // the slide isn't transformed, the image is
      return { left: r.left + img.offsetLeft, top: r.top + img.offsetTop, width: img.offsetWidth, height: img.offsetHeight };
    };
    const origin = (img: HTMLImageElement) => (img.style.transformOrigin = `${ox}% ${oy}%`);
    const aim = (img: HTMLImageElement, x: number, y: number) => {
      const b = box(img);
      ox = clamp(((x - b.left) / b.width) * 100);
      oy = clamp(((y - b.top) / b.height) * 100);
      origin(img);
    };
    const zoomIn = (img: HTMLImageElement, x: number, y: number) => {
      aim(img, x, y);
      img.style.transform = `scale(${SCALE})`;
      zoomed = img;
      lb.classList.add('zoomed');
      hint.textContent = 'Tap to zoom out';
    };
    const zoomOut = () => {
      if (!zoomed) return;
      zoomed.style.transform = '';
      zoomed = null;
      lb.classList.remove('zoomed');
      hint.textContent = 'Tap to zoom';
    };

    const go = (i: number, smooth = true) => {
      zoomOut();
      index = Math.max(0, Math.min(imgs.length - 1, i));
      counter.textContent = String(index + 1);
      load(index);
      load(index + 1);
      track.scrollTo({ left: index * track.clientWidth, behavior: smooth && !reduce ? 'smooth' : 'instant' });
    };

    g.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.zoom);
        load(i);
        lb.showModal();
        go(i, false);
      }),
    );
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.querySelectorAll<HTMLButtonElement>('[data-lb-step]').forEach((b) =>
      b.addEventListener('click', () => go(index + Number(b.dataset.lbStep))),
    );
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      else if (e.key === 'ArrowLeft') go(index - 1);
    });
    lb.addEventListener('close', zoomOut);

    track.addEventListener(
      'scroll',
      () => {
        const i = Math.round(track.scrollLeft / track.clientWidth);
        if (i === index) return;
        zoomOut();
        index = i;
        counter.textContent = String(i + 1);
        load(i + 1);
      },
      { passive: true },
    );

    // A tap toggles zoom; while zoomed the mouse pans by hovering, a finger by dragging.
    let down: { x: number; y: number; lx: number; ly: number } | null = null;
    let moved = false;
    track.addEventListener('pointerdown', (e) => {
      down = { x: e.clientX, y: e.clientY, lx: e.clientX, ly: e.clientY };
      moved = false;
      if (zoomed && e.pointerType !== 'mouse') track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (down && Math.hypot(e.clientX - down.x, e.clientY - down.y) > 6) moved = true;
      if (!zoomed) return;
      if (e.pointerType === 'mouse') return aim(zoomed, e.clientX, e.clientY);
      if (!down) return;
      const b = box(zoomed);
      ox = clamp(ox - ((e.clientX - down.lx) / ((SCALE - 1) * b.width)) * 100);
      oy = clamp(oy - ((e.clientY - down.ly) / ((SCALE - 1) * b.height)) * 100);
      origin(zoomed);
      down.lx = e.clientX;
      down.ly = e.clientY;
    });
    const up = () => (down = null);
    track.addEventListener('pointerup', up);
    track.addEventListener('pointercancel', up);
    track.addEventListener('click', (e) => {
      if (moved) return;
      const img = (e.target as Element).closest<HTMLImageElement>('[data-lb-img]');
      if (zoomed) zoomOut();
      else if (img) zoomIn(img, e.clientX, e.clientY);
      else lb.close(); // tapped the empty space around the photo
    });
  });
</script>

<style>
  .gallery {
    position: relative;
  }
  .slides {
    display: grid;
    gap: 12px;
  }
  .slide {
    aspect-ratio: 4 / 5;
  }
  .slide :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zoom-hit {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .zoom-hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -6px;
  }
  .counter {
    display: none;
  }

  /* Viewer */
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .lb::backdrop {
    background: var(--paper);
  }
  .lb[open] {
    animation: lb-in 0.45s var(--ease);
  }
  .lb:global(.closing) {
    animation: lb-out 0.3s ease forwards;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  @keyframes lb-out {
    to {
      opacity: 0;
    }
  }
  .lb-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }
  .lb-track::-webkit-scrollbar {
    display: none;
  }
  .lb:global(.zoomed) .lb-track {
    overflow: hidden;
  }
  .lb-slide {
    position: relative;
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    padding: 64px var(--gutter);
    overflow: hidden;
    scroll-snap-align: start;
    cursor: zoom-out;
  }
  .lb-slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    filter: var(--photo-filter);
    cursor: zoom-in;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 0.45s var(--ease);
  }
  .lb:global(.zoomed) .lb-slide img {
    cursor: zoom-out;
    touch-action: none;
  }
  .lb-bar {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    margin: 0;
    pointer-events: none;
  }
  .lb-x,
  .lb-nav {
    position: absolute;
    background: color-mix(in srgb, var(--paper) 85%, transparent);
  }
  .lb-x {
    top: 16px;
    right: var(--gutter);
  }
  .lb-nav {
    top: 50%;
    translate: 0 -50%;
    transition: opacity 0.3s;
  }
  .lb-prev {
    left: var(--gutter);
  }
  .lb-next {
    right: var(--gutter);
  }
  .lb:global(.zoomed) .lb-nav {
    opacity: 0;
    pointer-events: none;
  }
  @media (hover: none) {
    .lb-nav {
      display: none; /* swipe instead */
    }
  }
  @media (max-width: 860px) {
    .slides {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 calc(var(--gutter) * -1);
    }
    .slides::-webkit-scrollbar {
      display: none;
    }
    .slide {
      flex: 0 0 100%;
      scroll-snap-align: start;
      border-radius: 0;
    }
    .counter {
      display: block;
      position: absolute;
      right: 0;
      bottom: 12px;
      padding: 6px 10px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--paper) 88%, transparent);
    }
  }
</style>
