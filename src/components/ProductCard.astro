---
import { categoryOf, itemPath, catalogNo, statusRank, fitData, type Item } from '../lib/items';
import { peso } from '../lib/format';
import { shortCategory } from '../config/site';
import Hanger from './Hanger.astro';
import ProductMedia from './ProductMedia.astro';
import SaveButton from './SaveButton.astro';

interface Props {
  item: Item;
  eager?: boolean;
  /** Position in the default ordering (used to reset sorting). */
  order?: number;
  sizes?: string;
  /** False for duplicate copies of a card on the same page (keeps transition names unique). */
  transition?: boolean;
  /** Fade sold cards (default). Set false on the Released page. */
  dimSold?: boolean;
}

const { item, eager = false, order = 0, sizes, transition = true, dimSold = true } = Astro.props;
const { title, price, size, condition, status, listed } = item.data;
const category = categoryOf(item);
const fit = fitData(item);
const sold = status === 'sold' && dimSold;
---

<article
  class:list={['card', { sold }]}
  data-card
  data-id={item.id}
  data-category={category.slug}
  data-status={status}
  data-rank={statusRank(item)}
  data-price={price}
  data-listed={listed.getTime()}
  data-order={order}
  style={`--vt: card-${item.id}`}
  data-cursor-label="View"
  data-fit={fit ? JSON.stringify(fit) : undefined}
>
  <div class="media-wrap">
    <ProductMedia item={item} eager={eager} sizes={sizes} transition={transition} browse />
    <SaveButton id={item.id} title={title} class="card-save" />
    <button type="button" class="view label" data-quick={item.id} aria-label={`Quick view: ${title}`}>
      Quick view <span aria-hidden="true">+</span>
    </button>
    <button type="button" class="qv-touch round" data-quick={item.id} aria-label={`Quick view: ${title}`}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"></path><circle cx="12" cy="12" r="3"></circle>
      </svg>
    </button>
  </div>
  <div class="meta">
    <div class="line label muted">
      <span>№ {catalogNo(item)}</span>
      {
        item.data.seller.official ? (
          <span class="pick"><Hanger /> OFFARCHIVE.</span>
        ) : (
          <span class="by">
            @{item.data.seller.username}
            {item.data.seller.verified && <span class="tick" title="Verified seller">✓</span>}
          </span>
        )
      }
    </div>
    <h3><a class="stretch" href={itemPath(item)}>{title}</a></h3>
    <div class="line">
      <span class="price num">{status === 'sold' ? <s>{peso(price)}</s> : peso(price)}</span>
      <span class="label muted">{[shortCategory(category.name), size, condition].filter(Boolean).join(' · ')}</span>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
  }
  .media-wrap {
    position: relative;
    margin-bottom: 16px;
  }
  .pick {
    color: var(--accent);
  }
  .by {
    max-width: 60%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tick {
    display: inline-grid;
    place-items: center;
    width: 13px;
    height: 13px;
    margin-left: 4px;
    border-radius: 50%;
    background: var(--ok);
    color: #f6f2ec;
    font-size: 8px;
    vertical-align: 1px;
  }
  .card :global(.card-save) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
  }
  .view {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 3;
    border: 0;
    cursor: pointer;
    font: inherit;
    display: flex;
    justify-content: space-between;
    padding: 11px 14px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .card:hover .view,
  .view:focus-visible {
    opacity: 1;
    transform: none;
  }
  /* Touch screens have no hover: a small round button opens Quick view instead. */
  .qv-touch {
    display: none;
  }
  @media (hover: none) {
    .view {
      display: none;
    }
    .qv-touch {
      display: grid;
      position: absolute;
      right: 8px;
      bottom: 8px;
      z-index: 3;
    }
  }
  /* "New since your last visit" (added on the device by scripts/engage.ts) */
  .media-wrap :global(.new-chip) {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 2;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 9px;
    animation: chip-in 0.7s var(--ease) both 0.3s;
  }
  @media (hover: hover) {
    .card:hover .media-wrap :global(.new-chip) {
      opacity: 0;
    }
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .card:hover :global(.photo.is-on) {
    transform: scale(1.04);
  }
  .card:hover :global(.art) {
    transform: scale(1.06) rotate(-2deg);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  h3 {
    font: 400 24px/1.05 var(--display);
    letter-spacing: -0.01em;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .card:has(.stretch:focus-visible) {
    outline: 1.5px solid var(--accent);
    outline-offset: 6px;
  }
  .price {
    font: 500 14px var(--sans);
  }
  .sold .media-wrap,
  .sold h3,
  .sold .price {
    opacity: 0.5;
  }
  @media (hover: none) {
    .view {
      display: none;
    }
  }
  @media (max-width: 760px) {
    h3 {
      font-size: 20px;
    }
    .line.label,
    .line .label {
      font-size: 10px;
    }
    .line:last-child {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
