---
/**
 * Slide-in drawer listing the visitor's saved pieces, with one button that
 * copies an "are these available?" message per seller for Messenger.
 */
---

<dialog class="drawer" id="saved" aria-labelledby="saved-title">
  <div class="panel">
    <div class="dhead">
      <h2 id="saved-title">Saved <span class="num label" data-saved-count>0</span></h2>
      <button type="button" class="x label" data-drawer-close>Close</button>
    </div>
    <p class="label muted intro">Saved on this device · every piece is one of one</p>

    <ul class="list" data-saved-list></ul>

    <div class="empty" data-saved-empty>
      <p class="serif">Nothing saved <em>yet.</em></p>
      <p class="muted">Tap the bookmark on any piece to keep it here, then ask about everything in one message.</p>
      <a class="btn btn--ghost" href="/#archive" data-drawer-close>Browse the archive <span class="arrow">→</span></a>
    </div>

    <div class="foot" data-saved-foot hidden>
      <div class="total">
        <span class="label muted">Total (available)</span>
        <span class="num" data-saved-total>₱0</span>
      </div>
      <div class="asks" data-saved-asks></div>
      <div class="foot-row">
        <span class="label muted">Copies a message with the links</span>
        <button type="button" class="link" data-saved-clear>Clear all</button>
      </div>
    </div>
  </div>
</dialog>

<style>
  .drawer {
    margin: 0 0 0 auto;
    width: min(460px, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .drawer::backdrop {
    background: var(--scrim);
    backdrop-filter: blur(3px);
  }
  .drawer[open] {
    animation: in 0.55s var(--ease);
  }
  .drawer[open]::backdrop {
    animation: fade 0.4s ease;
  }
  @keyframes in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 28px 28px;
  }
  .dhead {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  h2 {
    font-size: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  h2 .label {
    display: grid;
    place-items: center;
    min-width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--accent);
    color: #f6f2ec;
    padding: 0 7px;
  }
  .x {
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 9px 14px;
  }
  .intro {
    margin: 10px 0 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }
  .list :global(.sv) {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    animation: fade 0.4s ease;
  }
  .list :global(.sv.sold) {
    opacity: 0.55;
  }
  .list :global(.sv-media) {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--paper-2);
    overflow: hidden;
  }
  .list :global(.sv-media img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .list :global(.sv-media svg) {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .list :global(.sv-body) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .list :global(.sv-title) {
    font: 400 22px/1.1 var(--display);
  }
  .list :global(.sv-status) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }
  .list :global(.sv-side) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
  }
  .list :global(.sv-remove) {
    background: none;
    border: 0;
    padding: 0;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .list :global(.sv-remove:hover) {
    color: var(--accent);
  }
  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 12px;
  }
  .empty .serif {
    font-size: 36px;
    line-height: 1;
  }
  .empty .muted {
    max-width: 34ch;
    margin-bottom: 10px;
  }
  .foot {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 20px;
  }
  .total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .total .num {
    font: 400 32px var(--display);
  }
  .asks {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .foot-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .foot-row .link {
    font-size: 11px;
  }
  @media (max-width: 760px) {
    .panel {
      padding: 18px 20px 24px;
    }
  }
</style>
