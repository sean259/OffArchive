---
/**
 * Create / edit a listing. Photos are resized in the browser (max 1600px, JPEG, EXIF/GPS stripped)
 * and uploaded straight to Supabase Storage under <user id>/; the form then posts JSON to
 * /api/listings (create) or /api/listings/<id> (edit).
 */
import { CATEGORIES, sizeSpec } from '../config/site';
import { photoUrl } from '../lib/supabase';

export interface ListingDraft {
  uuid?: string;
  slug?: string;
  status?: string;
  title?: string;
  category?: string;
  price?: number;
  size?: string;
  condition?: string;
  art?: string;
  brand?: string | null;
  description?: string;
  fit?: string | null;
  flaws?: string;
  measurements?: Record<string, string>;
  images?: string[];
}

interface Props {
  listing?: ListingDraft;
  userId: string;
  verified: boolean;
}
const { listing = {}, userId, verified } = Astro.props;
const editing = Boolean(listing.uuid);
const m = listing.measurements ?? {};

// Item "type" doubles as the fallback drawing and decides which measurements to ask for.
const TYPES = [
  { value: 'tee', label: 'T-shirt / top', cat: 'Clothing', kind: 'top' },
  { value: 'overshirt', label: 'Shirt / overshirt', cat: 'Clothing', kind: 'top' },
  { value: 'jacket', label: 'Jacket / outerwear', cat: 'Clothing', kind: 'top' },
  { value: 'pants', label: 'Pants / shorts', cat: 'Clothing', kind: 'bottom' },
  { value: 'shoe', label: 'Sneakers / casual', cat: 'Shoes', kind: 'shoes' },
  { value: 'runner', label: 'Runners / sports', cat: 'Shoes', kind: 'shoes' },
  { value: 'book', label: 'Book', cat: 'Books & Supplies', kind: 'none' },
  { value: 'set', label: 'Supplies / set', cat: 'Books & Supplies', kind: 'none' },
  { value: 'perfume', label: 'Full bottle', cat: 'Fragrance', kind: 'none' },
  { value: 'decant', label: 'Decant / sample', cat: 'Fragrance', kind: 'none' },
  { value: 'bag', label: 'Bag / accessory', cat: 'Others', kind: 'none' },
  { value: 'box', label: 'Something else', cat: 'Others', kind: 'none' },
];
const MEASURES = [
  { key: 'pitToPit', label: 'Pit to pit', kind: 'top' },
  { key: 'length', label: 'Length', kind: 'top' },
  { key: 'shoulder', label: 'Shoulder', kind: 'top' },
  { key: 'sleeve', label: 'Sleeve', kind: 'top' },
  { key: 'waist', label: 'Waist', kind: 'bottom' },
  { key: 'rise', label: 'Rise', kind: 'bottom' },
  { key: 'inseam', label: 'Inseam', kind: 'bottom' },
  { key: 'legOpening', label: 'Leg opening', kind: 'bottom' },
  { key: 'insole', label: 'Insole length', kind: 'shoes' },
];
const category = listing.category ?? 'Clothing';
const art = listing.art ?? TYPES.find((t) => t.cat === category)!.value;
const spec = sizeSpec(category);
// Per-category size field settings, read by the script when the category changes.
const sizeSpecs = Object.fromEntries(CATEGORIES.map((c) => [c.name, { ...c.size, fitted: c.fitted }]));
const initialImages = (listing.images ?? []).map((path) => ({ path, url: photoUrl(path) }));
---

<form
  class="lf"
  data-listing-form
  data-user={userId}
  data-id={listing.uuid}
  data-images={JSON.stringify(initialImages)}
  data-size-specs={JSON.stringify(sizeSpecs)}
  novalidate
>
  {
    editing && listing.status === 'rejected' && (
      <div class="notice error">Saving your changes resubmits this listing for review.</div>
    )
  }
  {
    !verified && (
      <div class="notice">
        <span>✳</span>
        <span>
          New listings are reviewed by OFFARCHIVE. before going live, usually within a day.
          {editing && ' Changing the title, photos or description of a live listing sends it back for a quick review.'}
        </span>
      </div>
    )
  }

  <section class="block">
    <header>
      <span class="step">01</span>
      <div>
        <h2>Photos</h2>
        <p class="muted">Up to 8. Natural light, plain background. Include the tag and any flaws. The first photo is the cover.</p>
      </div>
    </header>
    <div class="photos" data-photos></div>
    <label class="add" data-add>
      <input type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple data-file hidden />
      <span class="plus">+</span>
      <span class="label">Add photos</span>
    </label>
  </section>

  <section class="block">
    <header>
      <span class="step">02</span>
      <div><h2>The piece</h2></div>
    </header>
    <label class="field">
      <span class="label">Title</span>
      <input class="input" name="title" value={listing.title} required minlength="3" maxlength="80" placeholder="e.g. Washed Boxy Tee" />
    </label>
    <div class="two">
      <label class="field">
        <span class="label">Category</span>
        <select class="select" name="category" data-category>
          {CATEGORIES.map((c) => <option value={c.name} selected={c.name === category}>{c.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="label">Type</span>
        <select class="select" name="art" data-type>
          {TYPES.map((t) => <option value={t.value} data-cat={t.cat} data-kind={t.kind} selected={t.value === art}>{t.label}</option>)}
        </select>
      </label>
    </div>
    <div class="three" data-row>
      <label class="field">
        <span class="label">Price (₱)</span>
        <input class="input" name="price" type="number" inputmode="numeric" min="1" max="999999" step="1" value={listing.price} required placeholder="650" />
      </label>
      <label class="field" data-size-field hidden={!spec}>
        <span class="label" data-size-label>{spec ? (spec.required ? spec.label : `${spec.label} (optional)`) : 'Size'}</span>
        <input class="input" name="size" value={listing.size} required={spec?.required ?? false} maxlength="30" placeholder={spec?.placeholder ?? ''} />
      </label>
      <label class="field">
        <span class="label">Condition</span>
        <select class="select" name="condition">
          {['Like New', 'Excellent', 'Good', 'Fair'].map((c) => <option selected={c === (listing.condition ?? 'Excellent')}>{c}</option>)}
        </select>
      </label>
    </div>
    <label class="field">
      <span class="label">Brand (optional)</span>
      <input class="input" name="brand" value={listing.brand ?? ''} maxlength="60" placeholder="e.g. Uniqlo, Nike, Levi’s" />
    </label>
    <label class="field">
      <span class="label">Description</span>
      <textarea class="textarea" name="description" maxlength="2000" rows="5" placeholder="Fabric, how it fits, why you’re letting it go…">{listing.description ?? ''}</textarea>
    </label>
    <div class="two">
      <label class="field" data-fit-field>
        <span class="label">Fit (optional)</span>
        <input class="input" name="fit" value={listing.fit ?? ''} maxlength="120" placeholder="Boxy, true to size…" />
      </label>
      <label class="field">
        <span class="label">Flaws</span>
        <input class="input" name="flaws" value={listing.flaws ?? ''} maxlength="300" placeholder="None noted. See photos." />
      </label>
    </div>
  </section>

  <section class="block" data-measure-block>
    <header>
      <span class="step">03</span>
      <div>
        <h2>Measurements</h2>
        <p class="muted">Lay it flat and measure in inches. Buyers trust listings with measurements, and the fit finder uses them. <a class="link" href="/size-guide/" target="_blank">How to measure ↗</a></p>
      </div>
    </header>
    <div class="measures">
      {
        MEASURES.map((x) => (
          <label class="field" data-kind={x.kind}>
            <span class="label">{x.label}</span>
            <input class="input" name={`m.${x.key}`} value={m[x.key] ?? ''} maxlength="20" placeholder='e.g. 22"' />
          </label>
        ))
      }
    </div>
  </section>

  <div class="error notice" data-form-error hidden></div>

  <div class="submit">
    <button class="btn" type="submit" data-submit>
      {editing ? 'Save changes' : verified ? 'Publish listing' : 'Submit for review'} <span class="arrow">→</span>
    </button>
    <a class="link" href="/account/">Cancel</a>
  </div>
</form>

<script>
  import { createBrowserClient } from '@supabase/ssr';
  import { toast } from '../lib/toast';

  const URL_ = import.meta.env.PUBLIC_SUPABASE_URL as string;
  const KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string;
  const BUCKET = 'listing-images';
  const MAX = 8;

  type Pic = { path?: string; url: string; uploading?: boolean };

  const form = document.querySelector<HTMLFormElement>('[data-listing-form]');
  if (form) {
    const supabase = createBrowserClient(URL_, KEY);
    const userId = form.dataset.user!;
    const id = form.dataset.id;
    const photosEl = form.querySelector<HTMLElement>('[data-photos]')!;
    const fileInput = form.querySelector<HTMLInputElement>('[data-file]')!;
    const addBtn = form.querySelector<HTMLElement>('[data-add]')!;
    const errorEl = form.querySelector<HTMLElement>('[data-form-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const catSel = form.querySelector<HTMLSelectElement>('[data-category]')!;
    const typeSel = form.querySelector<HTMLSelectElement>('[data-type]')!;
    const specs: Record<string, { label?: string; placeholder?: string; required?: boolean; fitted: boolean }> = JSON.parse(
      form.dataset.sizeSpecs || '{}',
    );
    let pics: Pic[] = JSON.parse(form.dataset.images || '[]');
    const uploadedThisSession = new Set<string>();

    /* ── Type & measurement fields follow the category ── */
    function syncType() {
      const cat = catSel.value;
      let firstMatch: HTMLOptionElement | undefined;
      [...typeSel.options].forEach((o) => {
        const show = o.dataset.cat === cat;
        o.hidden = !show;
        o.disabled = !show;
        if (show && !firstMatch) firstMatch = o;
      });
      if (typeSel.selectedOptions[0]?.dataset.cat !== cat && firstMatch) typeSel.value = firstMatch.value;
      const kind = typeSel.selectedOptions[0]?.dataset.kind ?? 'none';
      form!.querySelectorAll<HTMLElement>('[data-measure-block] [data-kind]').forEach((f) => (f.hidden = f.dataset.kind !== kind));
      form!.querySelector<HTMLElement>('[data-measure-block]')!.hidden = kind === 'none';

      // Size: label/placeholder per category; hidden for categories without one (e.g. Others).
      const spec = specs[cat];
      const sizeField = form!.querySelector<HTMLElement>('[data-size-field]')!;
      const sizeInput = sizeField.querySelector<HTMLInputElement>('input')!;
      sizeField.hidden = !spec?.label;
      sizeInput.required = Boolean(spec?.required);
      sizeInput.placeholder = spec?.placeholder ?? '';
      sizeField.querySelector<HTMLElement>('[data-size-label]')!.textContent = spec?.label
        ? spec.required ? spec.label : `${spec.label} (optional)`
        : 'Size';
      form!.querySelector<HTMLElement>('[data-row]')!.classList.toggle('no-size', !spec?.label);
      // Fit notes only make sense for clothing and shoes.
      form!.querySelector<HTMLElement>('[data-fit-field]')!.hidden = !spec?.fitted;
    }
    catSel.addEventListener('change', syncType);
    typeSel.addEventListener('change', syncType);
    syncType();

    /* ── Photos ── */
    function renderPics() {
      photosEl.innerHTML = pics
        .map(
          (p, i) => `
          <figure class="pic${p.uploading ? ' busy' : ''}">
            <img src="${p.url}" alt="Photo ${i + 1}">
            ${i === 0 ? '<span class="cover label">Cover</span>' : ''}
            ${p.uploading ? '<span class="spin" aria-label="Uploading"></span>' : ''}
            <div class="pic-tools">
              <button type="button" data-move="${i}" data-dir="-1" aria-label="Move photo ${i + 1} left" ${i === 0 ? 'disabled' : ''}>←</button>
              <button type="button" data-move="${i}" data-dir="1" aria-label="Move photo ${i + 1} right" ${i === pics.length - 1 ? 'disabled' : ''}>→</button>
              <button type="button" data-remove="${i}" aria-label="Remove photo ${i + 1}">×</button>
            </div>
          </figure>`,
        )
        .join('');
      addBtn.hidden = pics.length >= MAX;
    }

    async function shrink(file: File): Promise<Blob> {
      const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
      const scale = Math.min(1, 1600 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      // Re-encoding through a canvas drops EXIF metadata, including GPS location.
      return new Promise((resolve, reject) => canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('encode'))), 'image/jpeg', 0.84));
    }

    async function addFiles(files: FileList) {
      const room = MAX - pics.length;
      const list = [...files].slice(0, room);
      if (files.length > room) toast(`Only ${MAX} photos per listing.`);
      await Promise.all(
        list.map(async (file) => {
          const pic: Pic = { url: URL.createObjectURL(file), uploading: true };
          pics.push(pic);
          renderPics();
          try {
            const blob = await shrink(file);
            const path = `${userId}/${crypto.randomUUID()}.jpg`;
            const { error } = await supabase.storage.from(BUCKET).upload(path, blob, { contentType: 'image/jpeg', cacheControl: '31536000', upsert: false });
            if (error) throw error;
            pic.path = path;
            uploadedThisSession.add(path);
          } catch (err) {
            console.error(err);
            pics = pics.filter((p) => p !== pic);
            toast(`Couldn’t add ${file.name}. Try a JPG or PNG under 15 MB.`);
          } finally {
            pic.uploading = false;
            renderPics();
          }
        }),
      );
    }

    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) addFiles(fileInput.files);
      fileInput.value = '';
    });
    photosEl.addEventListener('click', async (e) => {
      const t = (e.target as Element).closest<HTMLButtonElement>('button');
      if (!t) return;
      if (t.dataset.move) {
        const i = Number(t.dataset.move);
        const j = i + Number(t.dataset.dir);
        [pics[i], pics[j]] = [pics[j], pics[i]];
      } else if (t.dataset.remove) {
        const [gone] = pics.splice(Number(t.dataset.remove), 1);
        // Photos added in this session can be deleted right away; saved ones are cleaned up on save.
        if (gone?.path && uploadedThisSession.has(gone.path)) supabase.storage.from(BUCKET).remove([gone.path]);
      }
      renderPics();
    });
    // Drag & drop onto the photo area.
    form.addEventListener('dragover', (e) => e.preventDefault());
    form.addEventListener('drop', (e) => {
      if (!e.dataTransfer?.files.length) return;
      e.preventDefault();
      addFiles(e.dataTransfer.files);
    });
    renderPics();

    /* ── Submit ── */
    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      if (pics.some((p) => p.uploading)) return showError('Wait for the photos to finish uploading.');
      if (!pics.length) return showError('Add at least one photo.');
      if (!form.reportValidity()) return;

      const fd = new FormData(form);
      const measurements: Record<string, string> = {};
      for (const [k, v] of fd.entries()) if (k.startsWith('m.') && String(v).trim()) measurements[k.slice(2)] = String(v).trim();
      const kind = typeSel.selectedOptions[0]?.dataset.kind;
      const visible = new Set(
        [...form.querySelectorAll<HTMLInputElement>(`[data-measure-block] [data-kind="${kind}"] input`)].map((i) => i.name.slice(2)),
      );
      const payload = {
        title: fd.get('title'),
        category: fd.get('category'),
        art: fd.get('art'),
        price: Number(fd.get('price')),
        size: form.querySelector<HTMLElement>('[data-size-field]')!.hidden ? '' : fd.get('size'),
        condition: fd.get('condition'),
        brand: fd.get('brand'),
        description: fd.get('description'),
        fit: form.querySelector<HTMLElement>('[data-fit-field]')!.hidden ? '' : fd.get('fit'),
        flaws: fd.get('flaws'),
        measurements: Object.fromEntries(Object.entries(measurements).filter(([k]) => visible.has(k))),
        images: pics.map((p) => p.path).filter(Boolean),
      };

      submit.disabled = true;
      try {
        const res = await fetch(id ? `/api/listings/${id}` : '/api/listings', {
          method: id ? 'PATCH' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error ?? 'Something went wrong. Please try again.');
        uploadedThisSession.clear();
        location.href = id ? '/account/?notice=updated' : data.status === 'available' ? `/items/${data.slug}/` : '/account/?notice=created';
      } catch (err) {
        showError((err as Error).message);
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .lf {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
  }
  .block header {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .step {
    font: italic 400 30px/1 var(--display);
    color: var(--accent);
  }
  .block h2 {
    font-size: 34px;
    margin-bottom: 4px;
  }
  .block .muted {
    font-size: 14px;
    max-width: 60ch;
  }
  .two,
  .three {
    display: grid;
    gap: 16px;
  }
  .two {
    grid-template-columns: 1fr 1fr;
  }
  .three {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .three.no-size {
    grid-template-columns: 1fr 1fr;
  }
  .two:has(> [data-fit-field][hidden]) {
    grid-template-columns: 1fr;
  }
  .measures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }
  .photos:empty {
    display: none;
  }
  .photos :global(.pic) {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper-2);
  }
  .photos :global(.pic img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photos :global(.pic.busy img) {
    opacity: 0.4;
  }
  .photos :global(.cover) {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 9px;
  }
  .photos :global(.spin) {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 28px;
    height: 28px;
    border: 2px solid var(--line-strong);
    border-top-color: var(--ink);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .photos :global(.pic-tools) {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 6px;
    display: flex;
    gap: 4px;
    justify-content: flex-end;
  }
  .photos :global(.pic-tools button) {
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    font-size: 14px;
  }
  .photos :global(.pic-tools button:disabled) {
    opacity: 0.3;
  }
  .add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 120px;
    border: 1.5px dashed var(--line-strong);
    border-radius: 10px;
    cursor: pointer;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .add:hover {
    border-color: var(--ink);
    background: var(--paper-2);
  }
  .plus {
    font: 300 34px/1 var(--sans);
  }
  .submit {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  @media (max-width: 760px) {
    .two,
    .three {
      grid-template-columns: 1fr;
    }
    .measures {
      grid-template-columns: 1fr 1fr;
    }
    .submit .btn {
      flex: 1;
    }
  }
</style>
