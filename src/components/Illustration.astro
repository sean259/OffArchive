---
import { ART, type ArtKind } from '../lib/art';

interface Props {
  kind: ArtKind;
}
const { kind } = Astro.props;
---

<svg class="art" viewBox="0 0 100 125" aria-hidden="true"><path d={ART[kind]}></path></svg>

<style>
  .art {
    position: absolute;
    left: 16%;
    top: 14%;
    width: 68%;
    height: 68%;
    color: var(--ink-2);
    fill: none;
    stroke: currentColor;
    stroke-width: 0.9;
    stroke-linejoin: round;
    stroke-linecap: round;
    transition: transform 1.2s var(--ease);
  }
</style>
