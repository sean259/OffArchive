---
/** Edit an existing listing (owner, or any admin). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import ListingForm from '../../components/ListingForm.astro';
import type { ListingRow } from '../../lib/db-types';
import { STATUS_LABEL } from '../../lib/items';

const { supabase, user, profile } = Astro.locals;
const id = Astro.params.id ?? '';
if (!supabase || !user || !/^[0-9a-f-]{36}$/.test(id)) return Astro.rewrite('/404');

const { data } = await supabase.from('listings').select('*').eq('id', id).maybeSingle();
const listing = data as ListingRow | null;
if (!listing || (listing.seller_id !== user.id && profile?.role !== 'admin')) return Astro.rewrite('/404');
const otherSeller = listing.seller_id !== user.id;
---

<BaseLayout title={`Edit · ${listing.title}`} noindex>
  <div class="wrap page">
    <AccountNav />
    <div class="head">
      <div>
        <p class="label muted">Editing № {String(listing.catalog_no).padStart(3, '0')} · {STATUS_LABEL[listing.status]}</p>
        <h1 class="h">{listing.title}</h1>
      </div>
      <a class="link" href={`/items/${listing.slug}/`}>View listing</a>
    </div>
    {otherSeller && <div class="notice mb">You’re editing another seller’s listing as an admin.</div>}
    <ListingForm
      userId={user.id}
      verified={Boolean(profile?.verified || profile?.role === 'admin')}
      listing={{
        uuid: listing.id,
        slug: listing.slug,
        status: listing.status,
        title: listing.title,
        category: listing.category,
        price: listing.price,
        size: listing.size,
        condition: listing.condition,
        art: listing.art,
        brand: listing.brand,
        description: listing.description,
        fit: listing.fit,
        flaws: listing.flaws,
        measurements: listing.measurements,
        images: listing.images,
      }}
    />
  </div>
</BaseLayout>

<style>
  .page {
    padding-bottom: 120px;
    max-width: 980px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 28px;
  }
  .h {
    font-size: clamp(36px, 4vw, 60px);
    margin-top: 8px;
  }
  .mb {
    margin-bottom: 20px;
  }
</style>
