---
/** Seller dashboard: your listings, their review status, and quick status changes. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import Illustration from '../../components/Illustration.astro';
import { fromRow, STATUS_LABEL, itemPath, type Item } from '../../lib/items';
import { LISTING_SELECT, type ListingWithSeller } from '../../lib/db-types';
import { peso, shortDate } from '../../lib/format';

const { supabase, user, profile } = Astro.locals;
let listings: Item[] = [];
if (supabase && user) {
  const { data } = await supabase.from('listings').select(LISTING_SELECT).eq('seller_id', user.id).order('created_at', { ascending: false });
  listings = ((data ?? []) as ListingWithSeller[]).map(fromRow);
}
// Seller stats (views, saves, message taps). Missing until the listing_stats migration is run.
type Stat = { views: number; saves: number; messages: number; views_30: number; saves_30: number; messages_30: number };
const stats = new Map<string, Stat>();
const ids = listings.map((l) => l.uuid).filter((id): id is string => Boolean(id));
if (supabase && ids.length) {
  const { data, error } = await supabase.rpc('listing_stats_summary', { p_ids: ids });
  if (error) console.error('[account] stats:', error.message);
  for (const r of (data ?? []) as ({ listing_id: string } & Record<keyof Stat, number | string>)[]) {
    // bigint sums arrive as strings; saves can dip below zero (unsaves), so clamp for display.
    const n = (k: keyof Stat) => Math.max(0, Number(r[k]) || 0);
    stats.set(r.listing_id, {
      views: n('views'),
      saves: n('saves'),
      messages: n('messages'),
      views_30: n('views_30'),
      saves_30: n('saves_30'),
      messages_30: n('messages_30'),
    });
  }
}
const total30 = (k: 'views_30' | 'saves_30' | 'messages_30') => [...stats.values()].reduce((sum, s) => sum + s[k], 0);
const plural = (n: number, one: string, many = `${one}s`) => `${n.toLocaleString('en-PH')} ${n === 1 ? one : many}`;
const hasLive = listings.some((l) => ['available', 'reserved', 'sold'].includes(l.data.status));
const needsContact = !profile?.messenger && !profile?.phone;
const count = (s: string) => listings.filter((l) => l.data.status === s).length;
const NOTICES: Record<string, [string, string]> = {
  created: ['ok', 'Listing submitted. It’s in review and will go live once an admin approves it.'],
  live: ['ok', 'Your listing is live.'],
  updated: ['ok', 'Changes saved.'],
  deleted: ['ok', 'Listing deleted.'],
  profile: ['ok', 'Profile saved.'],
  'admin-only': ['error', 'That page is for admins only.'],
};
const notice = NOTICES[Astro.url.searchParams.get('notice') ?? ''];
---

<BaseLayout title="My listings" noindex>
  <div class="wrap page">
    <AccountNav />

    {notice && <div class:list={['notice', notice[0], 'mb']}>{notice[1]}</div>}
    {
      needsContact && (
        <div class="notice mb">
          <div>
            <strong>Before your first listing:</strong> add a Messenger username or phone number so buyers can reach you.{' '}
            <a class="link" href="/account/profile/?next=/sell/">
              Complete profile
            </a>
          </div>
        </div>
      )
    }

    <div class="stats">
      <div><span class="label muted">Live</span><strong>{count('available') + count('reserved')}</strong></div>
      <div><span class="label muted">In review</span><strong>{count('pending')}</strong></div>
      <div><span class="label muted">Needs changes</span><strong>{count('rejected')}</strong></div>
      <div><span class="label muted">Sold</span><strong>{count('sold')}</strong></div>
      <a class="btn new" href="/sell/">+ Sell an item</a>
    </div>

    {
      hasLive && (
        <section class="reach" aria-labelledby="reach-title">
          <div class="reach-head">
            <h2 id="reach-title" class="label muted">
              Last 30 days
            </h2>
            <span class="label muted">Your own visits don’t count</span>
          </div>
          <div class="reach-grid">
            <div>
              <strong class="num">{total30('views_30').toLocaleString('en-PH')}</strong>
              <span>Views</span>
              <small class="muted">People who opened a piece</small>
            </div>
            <div>
              <strong class="num">{total30('saves_30').toLocaleString('en-PH')}</strong>
              <span>Saves</span>
              <small class="muted">Added to someone’s Saved list</small>
            </div>
            <div>
              <strong class="num">{total30('messages_30').toLocaleString('en-PH')}</strong>
              <span>Message taps</span>
              <small class="muted">Tapped “Message” to ask about it</small>
            </div>
          </div>
          {total30('views_30') === 0 && (
            <p class="muted reach-tip">Numbers show up here as buyers start browsing your live pieces. Clear photos and measurements help them get found.</p>
          )}
        </section>
      )
    }

    {
      listings.length === 0 ? (
        <div class="empty">
          <p class="serif">
            Nothing listed <em>yet.</em>
          </p>
          <p class="muted">Snap a few photos, add the size and condition, and you’re live once it’s reviewed.</p>
          <a class="btn" href="/sell/">
            List your first piece <span class="arrow">→</span>
          </a>
        </div>
      ) : (
        <ul class="list">
          {listings.map((l) => {
            const d = l.data;
            const cover = d.images[0];
            const live = d.status === 'available' || d.status === 'reserved' || d.status === 'sold';
            return (
              <li class="row" data-listing={l.uuid}>
                <a class="thumb frame" href={itemPath(l)}>
                  {cover && 'src' in cover ? <img src={cover.src} alt="" loading="lazy" /> : <Illustration kind={d.art} />}
                </a>
                <div class="info">
                  <span class="label muted">
                    № {d.no} · {d.category} · listed {shortDate(d.listed)}
                  </span>
                  <a class="title" href={itemPath(l)}>
                    {d.title}
                  </a>
                  <span class="num">{peso(d.price)}</span>
                  {live &&
                    (() => {
                      const s = l.uuid ? stats.get(l.uuid) : undefined;
                      return (
                        <span class="engage label muted" title="All time · your own visits don’t count">
                          {plural(s?.views ?? 0, 'view')} · {plural(s?.saves ?? 0, 'save')} · {plural(s?.messages ?? 0, 'message tap')}
                        </span>
                      );
                    })()}
                  {d.status === 'rejected' && d.reviewNote && <span class="review">Admin note: {d.reviewNote}</span>}
                </div>
                <div class="state">
                  <span class="chip-status">
                    <span class:list={['dot', d.status]} />
                    {STATUS_LABEL[d.status]}
                  </span>
                  {live && (
                    <label class="sr-only" for={`st-${l.uuid}`}>
                      Status
                    </label>
                  )}
                  {live && (
                    <select class="select mini" id={`st-${l.uuid}`} data-status-select>
                      {(['available', 'reserved', 'sold'] as const).map((s) => (
                        <option value={s} selected={d.status === s}>
                          Mark {STATUS_LABEL[s].toLowerCase()}
                        </option>
                      ))}
                    </select>
                  )}
                </div>
                <div class="acts">
                  <a class="btn btn--ghost btn--sm" href={`/sell/${l.uuid}/`}>
                    {d.status === 'rejected' ? 'Fix & resubmit' : 'Edit'}
                  </a>
                  <button type="button" class="del label" data-delete>
                    Delete
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</BaseLayout>

<script>
  import { toast } from '../../lib/toast';

  const call = async (id: string, method: 'PATCH' | 'DELETE', body?: object) => {
    const res = await fetch(`/api/listings/${id}`, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error ?? 'Something went wrong.');
    return data;
  };

  document.querySelectorAll<HTMLElement>('[data-listing]').forEach((row) => {
    const id = row.dataset.listing!;
    row.querySelector<HTMLSelectElement>('[data-status-select]')?.addEventListener('change', async (e) => {
      const select = e.currentTarget as HTMLSelectElement;
      try {
        await call(id, 'PATCH', { status: select.value });
        location.reload();
      } catch (err) {
        toast((err as Error).message);
      }
    });
    row.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm('Delete this listing and its photos? This can’t be undone.')) return;
      try {
        await call(id, 'DELETE');
        location.href = '/account/?notice=deleted';
      } catch (err) {
        toast((err as Error).message);
      }
    });
  });
</script>

<style>
  .page {
    padding-bottom: 120px;
  }
  .mb {
    margin-bottom: 20px;
  }
  .stats {
    display: flex;
    align-items: stretch;
    gap: 1px;
    margin-bottom: 32px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .stats div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    background: var(--paper);
  }
  .stats strong {
    font: 400 44px/1 var(--display);
  }
  .stats .new {
    height: auto;
    border-radius: 0;
    align-self: stretch;
    padding: 0 28px;
  }
  /* Seller stats */
  .reach {
    margin: -8px 0 36px;
    padding: 0;
  }
  .reach-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .reach-head h2 {
    font: 400 11px/1.4 var(--mono);
    letter-spacing: 0.1em;
  }
  .reach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .reach-grid div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    background: var(--paper-2);
  }
  .reach-grid strong {
    font: 400 36px/1 var(--display);
    margin-bottom: 4px;
  }
  .reach-grid span {
    font-weight: 500;
    font-size: 14px;
  }
  .reach-grid small {
    font-size: 12px;
  }
  .reach-tip {
    margin-top: 10px;
    font-size: 13px;
  }
  .engage {
    margin-top: 2px;
  }
  @media (max-width: 640px) {
    .reach-grid div {
      padding: 14px 12px;
    }
    .reach-grid strong {
      font-size: 28px;
    }
    .reach-grid small {
      display: none;
    }
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 72px 1fr auto auto;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .thumb {
    position: relative;
    aspect-ratio: 4 / 5;
    display: block;
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .title {
    font: 400 26px/1.1 var(--display);
  }
  .title:hover {
    color: var(--accent);
  }
  .review {
    font-size: 13px;
    color: var(--accent);
  }
  .state {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .mini {
    width: auto;
    padding: 6px 30px 6px 10px;
    font-size: 13px;
    border-radius: 999px;
  }
  .acts {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .del {
    background: none;
    border: 0;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .del:hover {
    color: var(--accent);
  }
  .empty {
    padding: 64px 0;
    text-align: center;
  }
  .empty .serif {
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    margin-bottom: 10px;
  }
  .empty .muted {
    margin: 0 auto 28px;
    max-width: 40ch;
  }
  @media (max-width: 860px) {
    .stats {
      flex-wrap: wrap;
    }
    .stats div {
      flex: 1 1 40%;
    }
    .stats .new {
      flex: 1 1 100%;
      height: 52px;
    }
    .row {
      grid-template-columns: 64px 1fr;
      gap: 10px 14px;
    }
    .state,
    .acts {
      grid-column: 2;
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
