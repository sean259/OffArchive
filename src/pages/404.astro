---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="label muted">(Error 404)</p>
      <h1 class="rise">
        <span class="ln" style="--i:0"><span>Not in the</span></span>
        <span class="ln" style="--i:1"><span><em>archive.</em></span></span>
      </h1>
      <p class="lede">This page doesn’t exist, or the piece has already found a new home.</p>
      <a class="btn" href="/#archive">Back to the archive <span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 24px 0 32px;
  }
  .lede {
    font: 400 clamp(22px, 2vw, 28px) / 1.3 var(--display);
    max-width: 32ch;
    margin: 0 0 36px;
  }
</style>
