---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import MessengerButton from '../../components/MessengerButton.astro';
import ShareButton from '../../components/ShareButton.astro';
import SaveButton from '../../components/SaveButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import FitFinder from '../../components/FitFinder.astro';
import SellerCard from '../../components/SellerCard.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import Hanger from '../../components/Hanger.astro';
import {
  getItems,
  getItemBySlug,
  categoryOf,
  catalogNo,
  itemPath,
  isPublic,
  isRemote,
  messengerFor,
  MEASUREMENT_LABELS,
  fitData,
  STATUS_LABEL,
} from '../../lib/items';
import { peso, shortDate } from '../../lib/format';
import { SITE, sizeSpec } from '../../config/site';

const slug = Astro.params.slug ?? '';
// The request's client lets owners and admins preview listings that aren't public yet.
const item = await getItemBySlug(slug, Astro.locals.supabase);
if (!item) return Astro.rewrite('/404');

const items = await getItems();
const index = items.findIndex((i) => i.id === item.id);
const prev = index > 0 ? items[index - 1] : undefined;
const next = index >= 0 ? items[index + 1] : undefined;

const d = item.data;
const seller = d.seller;
const category = categoryOf(item);
const isClothing = category.slug === 'clothing';
const fit = fitData(item);
const sold = d.status === 'sold';
const preview = !isPublic(item);
const isOwner = Astro.locals.user?.id === seller.id;
const isAdmin = Astro.locals.profile?.role === 'admin';
const pageUrl = new URL(itemPath(item), Astro.site ?? SITE.url).href;
const paragraphs = item.body.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);

const measurements = Object.entries(d.measurements ?? {}).filter(([, v]) => v) as [string, string][];
const sameCategory = items.filter((i) => i.id !== item.id && i.data.category === d.category && i.data.status !== 'sold');
const others = items.filter((i) => i.id !== item.id && i.data.category !== d.category && i.data.status === 'available');
const related = [...sameCategory, ...others].slice(0, 4);

const sizeName = sizeSpec(d.category)?.label ?? 'Size';
const hasSize = Boolean(sizeSpec(d.category) && d.size);
const message = `Hi! I'm interested in the ${d.title} (${[hasSize && d.size, peso(d.price)].filter(Boolean).join(', ')}) on OFFARCHIVE. Is it still available? ${pageUrl}`;
const contactHref = seller.messenger ? messengerFor(seller) : seller.phone ? `sms:${seller.phone.replace(/\s/g, '')}` : null;

const cover = d.images[0];
const ogImage = !cover ? '/og/default.png' : isRemote(cover) ? cover.src : (await getImage({ src: cover, width: 1200, format: 'jpeg' })).src;
const description = `${d.title} — ${d.condition} condition, ${hasSize ? `${sizeName.toLowerCase()} ${d.size}, ` : ''}${peso(d.price)}. ${STATUS_LABEL[d.status]} on ${SITE.name}`;

const availability =
  d.status === 'available' ? 'https://schema.org/InStock' : d.status === 'reserved' ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/SoldOut';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  category: d.category,
  sku: `OA-${catalogNo(item)}`,
  ...(d.brand && { brand: { '@type': 'Brand', name: d.brand } }),
  image: new URL(ogImage, pageUrl).href,
  description: item.body || description,
  offers: {
    '@type': 'Offer',
    price: d.price,
    priceCurrency: 'PHP',
    availability,
    itemCondition: 'https://schema.org/UsedCondition',
    url: pageUrl,
    seller: { '@type': seller.official ? 'Organization' : 'Person', name: seller.name },
  },
};

const statusNote: Record<string, string> = {
  available: 'Available — message to reserve.',
  reserved: 'On hold for another buyer. Message to join the waitlist.',
  sold: 'This piece has found a new home.',
  pending: 'In review — not visible to the public yet.',
  rejected: 'Needs changes before it can go live.',
  hidden: 'Hidden by an admin.',
};
const trust = seller.official
  ? SITE.trust
  : ['One of one', seller.verified ? 'Verified seller' : 'Reviewed by OFFARCHIVE.', seller.location];
---

<BaseLayout title={d.title} description={description} image={ogImage} noindex={preview}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

  <article class="wrap item">
    {
      (preview || isOwner || isAdmin) && (
        <div class:list={['owner-bar', d.status]}>
          <span class="label">
            <span class:list={['dot', d.status]} /> {preview ? `Preview · ${STATUS_LABEL[d.status]}` : 'Your listing'}
          </span>
          {d.status === 'rejected' && d.reviewNote && <span class="note-text">Admin note: {d.reviewNote}</span>}
          {d.status === 'pending' && <span class="note-text">An admin will review it soon. You'll see it go live in your account.</span>}
          {(isOwner || isAdmin) && item.uuid && (
            <a class="link" href={`/sell/${item.uuid}/`}>
              Edit listing
            </a>
          )}
        </div>
      )
    }
    <nav class="crumbs label muted" aria-label="Breadcrumb">
      <a href="/#archive">Archive</a>
      <span aria-hidden="true">/</span>
      <a href={`/?c=${category.slug}#archive`}>{category.name}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">№ {catalogNo(item)}</span>
    </nav>

    <div class="layout">
      <Gallery item={item} />

      <aside class="panel">
        <div class="top label muted">
          <span>№ {catalogNo(item)} — {d.brand ? `${d.brand} · ` : ''}{category.name}</span>
          <span>Listed {shortDate(d.listed)}</span>
        </div>

        <h1>{d.title}</h1>

        <div class="pricerow">
          <span class="price num">{sold ? <s>{peso(d.price)}</s> : peso(d.price)}</span>
          <span class="status label">
            <span class:list={['dot', d.status]}></span>
            {statusNote[d.status]}
          </span>
        </div>

        <dl class="specs">
          {
            hasSize && (
              <div>
                <dt class="label muted">{sizeName}</dt>
                <dd>{d.size}</dd>
              </div>
            )
          }
          <div>
            <dt class="label muted">Condition</dt>
            <dd><a href="/how-to-buy/#condition" class="cond">{d.condition}</a></dd>
          </div>
          <div>
            <dt class="label muted">Edition</dt>
            <dd>1 of 1</dd>
          </div>
        </dl>

        {
          fit && !sold && (
            <details class="fitbox" data-fitbox>
              <summary>
                <span class="fb-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 8h18v8H3z M7 8v3 M11 8v4 M15 8v3 M19 8v4" />
                  </svg>
                </span>
                <span class="fb-text">
                  <span class="label muted">Fit finder · height &amp; weight</span>
                  <span class="serif" data-fit-summary>Find your size</span>
                </span>
              </summary>
              <div class="fb-body">
                <FitFinder item={fit} id={`ff-${item.id}`} />
              </div>
            </details>
          )
        }

        <div class="actions" data-main-cta>
          {
            contactHref && !preview ? (
              <MessengerButton
                message={message}
                disabled={sold}
                block
                href={contactHref}
                label={seller.messenger ? (seller.official ? 'Message on Messenger' : `Message ${seller.name.split(' ')[0]}`) : 'Text the seller'}
              />
            ) : (
              <span class="btn btn--block" aria-disabled="true">
                {preview ? 'Not live yet' : 'Seller has no contact set'}
              </span>
            )
          }
          <div class="secondary">
            <SaveButton id={item.id} title={d.title} withLabel />
            <ShareButton title={d.title} />
          </div>
        </div>
        {!sold && <p class="label muted hint">Tapping the button copies a ready-made message for you.</p>}

        <SellerCard seller={seller} />

        <ul class="trust label">
          {
            trust.map((t) => (
              <li>
                <Hanger />
                {t}
              </li>
            ))
          }
        </ul>

        <div class="acc">
          <details open>
            <summary>Description</summary>
            <div class="body prose">
              {paragraphs.map((p) => <p>{p}</p>)}
              {d.fit && <p><strong>Fit:</strong> {d.fit}</p>}
              {isClothing && seller.official && <p class="note">Seller reference is {SITE.sellerHeight}. Please refer to actual garment measurements for the best fit.</p>}
            </div>
          </details>
          {
            (measurements.length > 0 || isClothing || category.slug === 'shoes') && (
              <details>
                <summary>Measurements</summary>
                <div class="body">
                  {measurements.length > 0 ? (
                    <dl class="measure">
                      {measurements.map(([k, v]) => (
                        <div>
                          <dt class="label muted">{MEASUREMENT_LABELS[k] ?? k}</dt>
                          <dd>{v}</dd>
                        </div>
                      ))}
                    </dl>
                  ) : (
                    <p class="muted">Measurements available on request — just ask in Messenger.</p>
                  )}
                  <a class="link" href={category.slug === 'shoes' ? '/size-guide/#shoes' : '/size-guide/'}>How we measure</a>
                </div>
              </details>
            )
          }
          <details>
            <summary>Condition &amp; flaws</summary>
            <div class="body">
              <p><strong>{d.condition}.</strong> {d.flaws}</p>
              <a class="link" href="/how-to-buy/#condition">Condition guide</a>
            </div>
          </details>
          <details>
            <summary>Payment &amp; delivery</summary>
            <div class="body">
              {seller.official ? (
                <p class="muted">{SITE.delivery}</p>
              ) : (
                <>
                  <p class="muted">
                    Payment and handoff are arranged directly with {seller.name}. OFFARCHIVE. doesn't handle payments for community sellers.
                  </p>
                  <ul class="safety muted">
                    <li>Meet in a busy public place, or ask for photos and a tracking number when shipping.</li>
                    <li>Check the item before paying. Never send your OTP, password, or e-wallet PIN.</li>
                    <li>Something off? Message us and we'll look into the listing.</li>
                  </ul>
                </>
              )}
              <a class="link" href="/how-to-buy/">Full buying guide</a>
            </div>
          </details>
        </div>
      </aside>
    </div>

    <nav class="pager" aria-label="More pieces">
      {
        prev ? (
          <a href={itemPath(prev)} class="pg">
            <span class="label muted">← Previous</span>
            <span class="pt">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={itemPath(next)} class="pg nx">
            <span class="label muted">Next →</span>
            <span class="pt">{next.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  {
    related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <div class="rhead">
            <h2>
              You may <em>also like.</em>
            </h2>
            <a class="link" href="/#archive">
              Full archive
            </a>
          </div>
          <div class="grid">
            {related.map((r) => (
              <ProductCard item={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {!preview && <span hidden data-view-item={item.id} />}
  <RecentlyViewed />

  {
    !sold && !preview && contactHref && (
      <div class="buybar" data-buybar aria-hidden="true">
        <div>
          <span class="bt">{d.title}</span>
          <span class="label muted">
            {peso(d.price)}{hasSize && ` · ${d.size}`}
          </span>
        </div>
        <MessengerButton message={message} label="Message" href={contactHref ?? undefined} />
      </div>
    )
  }
</BaseLayout>

<script>
  // Mobile: show the sticky buy bar once the main button scrolls out of view.
  const bar = document.querySelector<HTMLElement>('[data-buybar]');
  const cta = document.querySelector('[data-main-cta]');
  if (bar && cta && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      const show = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.classList.toggle('on', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll('a').forEach((a) => (a.tabIndex = show ? 0 : -1));
    }).observe(cta);
  }
</script>

<style>
  .owner-bar {
    display: flex;
    align-items: center;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--paper-2);
  }
  .owner-bar.rejected {
    border-color: var(--accent);
  }
  .owner-bar .label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .note-text {
    flex: 1;
    color: var(--muted);
    font-size: 14px;
  }
  .safety {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
  }
  .safety li + li {
    margin-top: 4px;
  }
  .item {
    padding-top: 20px;
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
  }
  .crumbs a:hover {
    color: var(--ink);
  }
  .layout {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 4vw, 72px);
    align-items: start;
  }
  .panel {
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-size: clamp(48px, 5.4vw, 88px);
    line-height: 0.92;
    margin: 24px 0 20px;
  }
  .pricerow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .price {
    font: 400 36px var(--display);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 28px 0;
    border-block: 1px solid var(--line);
  }
  .specs div {
    padding: 16px 0;
  }
  .specs div + div {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  .specs dd {
    margin: 6px 0 0;
    font-size: 17px;
  }
  .cond {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .fitbox {
    margin: -8px 0 24px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--paper);
    transition: border-color 0.3s;
  }
  .fitbox[open] {
    border-color: var(--ink);
  }
  .fitbox summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 44px 14px 16px;
    font: inherit;
  }
  .fitbox summary::after {
    right: 18px;
  }
  .fb-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--paper-2);
    flex: none;
  }
  .fb-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fb-text .serif {
    font-size: 24px;
    line-height: 1.1;
  }
  .fb-body {
    padding: 4px 16px 18px;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .secondary {
    display: flex;
    gap: 10px;
  }
  .secondary :global(.save) {
    flex: 1;
  }
  .hint {
    margin-top: 14px;
  }
  .trust {
    list-style: none;
    margin: 28px 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .trust li {
    display: inline-flex;
    gap: 8px;
  }

  .acc {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    position: relative;
    list-style: none;
    cursor: pointer;
    padding: 18px 32px 18px 0;
    font: 400 24px var(--display);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font: 300 22px var(--sans);
    transition: transform 0.4s var(--ease);
  }
  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }
  .body {
    padding-bottom: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .prose :global(p) {
    margin: 0;
  }
  .note {
    font: italic 400 19px/1.35 var(--display);
    color: var(--muted);
  }
  .measure {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 20px;
    margin: 0;
    width: 100%;
  }
  .measure dd {
    margin: 4px 0 0;
    font-size: 17px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pg {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pg.nx {
    text-align: right;
    align-items: flex-end;
  }
  .pt {
    font: 400 clamp(24px, 2.6vw, 36px) / 1 var(--display);
    transition: color 0.3s;
  }
  .pg:hover .pt {
    color: var(--accent);
    font-style: italic;
  }

  .related {
    background: var(--paper-2);
  }
  .rhead {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px 20px;
  }

  .buybar {
    display: none;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .panel {
      position: static;
    }
    .buybar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: fixed;
      left: 10px;
      right: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      z-index: 40;
      padding: 10px 10px 10px 20px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--paper) 90%, transparent);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--line);
      box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.3);
      transform: translateY(140%);
      transition: transform 0.6s var(--ease);
    }
    .buybar.on {
      transform: none;
    }
    .buybar > div {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
    .bt {
      font: 400 20px/1.1 var(--display);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .buybar :global(.btn) {
      height: 46px;
      padding: 0 20px;
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 12px;
    }
    .measure {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
